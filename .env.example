# Google Maps — three keys, one per platform.
#
# Google allows a key exactly one *application* restriction: Websites, or iOS
# apps, or Android apps. An app that runs on all three therefore needs three
# keys. See src/lib/maps/keys.ts for which call uses which.
#
# Every one of these is optional. An unset key degrades to an empty string: the
# map screen reports itself unconfigured and nothing else is affected, so a
# checkout with no .env at all still builds, type-checks, and runs. Set only the
# ones you are building for.
#
# These are PUBLIC_ variables: they are inlined into the client bundle and are
# readable by anyone using the app. That is inherent to client-side Maps keys.
# What protects them is restriction, not secrecy — configure each one in the
# Google Cloud console as described below, and enable only the APIs it needs.

# Restriction: Websites (HTTP referrers)
# APIs: Maps JavaScript API, Places API (New), Geocoding API
# Referrers must include the production domain, your local dev ports, AND the
# native webview origins — place autocomplete and geocoding run as JavaScript
# inside the Capacitor shell, so they are referrer-checked even on device:
#   https://app.bmlt.app/*
#   http://localhost:5173/*        (npm run dev)
#   http://localhost:4173/*        (npm run preview)
#   https://localhost/*            (Android webview origin)
#   capacitor://localhost/*        (iOS webview origin)
PUBLIC_GOOGLE_MAPS_KEY_WEB=

# Restriction: iOS apps — bundle ID app.bmlt.search
# APIs: Maps SDK for iOS
PUBLIC_GOOGLE_MAPS_KEY_IOS=

# Restriction: Android apps — package app.bmlt.search + your signing SHA-1
# APIs: Maps SDK for Android
# The Android build ALSO needs this value in the manifest, which Gradle reads
# separately from GOOGLE_MAPS_KEY_ANDROID or android/local.properties. See the
# README — the Maps SDK for Android takes its key from the manifest, not from
# the apiKey passed to GoogleMap.create().
PUBLIC_GOOGLE_MAPS_KEY_ANDROID=

# SHA-1 of the certificate that signs your Android build, e.g.
# F0:5A:84:...:B9 (colons optional). Android's key restriction checks package
# name AND signature, and on device the app proves its identity to the Places and
# Geocoding REST endpoints with X-Android-Package + X-Android-Cert headers — it
# cannot read its own signature at runtime, so the value is supplied here.
#
# Use the debug keystore's SHA-1 for local builds:
#   keytool -list -v -keystore ~/.android/debug.keystore \
#     -alias androiddebugkey -storepass android -keypass android
# and your upload / Play app-signing certificate for release builds.
# iOS needs no equivalent: its bundle identifier is static and known.
PUBLIC_GOOGLE_MAPS_ANDROID_CERT_SHA1=
