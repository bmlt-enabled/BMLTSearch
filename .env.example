# Map credentials. Only Android still uses a Google key — web uses Apple MapKit
# JS (a token) and iOS uses native Apple Maps (nothing). See src/lib/maps/keys.ts
# and src/lib/maps/mapkit.ts.
#
# Every value is optional. An unset one degrades to an empty string: the map
# screen reports itself unconfigured and nothing else is affected, so a checkout
# with no .env at all still builds, type-checks, and runs. Set only the ones you
# are building for.
#
# These are PUBLIC_ variables: they are inlined into the client bundle and are
# readable by anyone using the app. That is inherent to client-side map
# credentials. What protects them is restriction, not secrecy.

# Apple MapKit JS token — the web map, place search and geocoding. Minted in the
# Apple developer portal (Maps token) and baked into the bundle at build time.
# MapKit tokens are meant to be exposed to the browser; what protects the token
# is its ORIGIN ALLOWLIST, which must include every origin the app is served from:
#
#   http://localhost:5173   (npm run dev)
#   http://localhost:4173   (npm run preview)
#   https://app.bmlt.app    (production)
#
# On Cloudflare Pages this MUST be set as a PLAINTEXT build variable, NOT a
# Secret — Cloudflare secrets are runtime-only and are not injected into the
# `vite build`, so a Secret bakes an empty string and the map shows unconfigured.
# Regenerate the token before its `exp` lapses.
PUBLIC_MAPKIT_TOKEN=

# Restriction: Android apps — package ie.nasouth.bmltsearch + your signing SHA-1
# APIs: Maps SDK for Android, Places API (New), Geocoding API
# On device this key both authenticates the native map view AND signs the REST
# autocomplete/geocoding calls (X-Android-Package + X-Android-Cert).
# The Android build ALSO needs this value in the manifest, which Gradle reads
# separately from GOOGLE_MAPS_KEY_ANDROID or android/local.properties. See the
# README — the Maps SDK for Android takes its key from the manifest, not from
# the apiKey passed to GoogleMap.create().
PUBLIC_GOOGLE_MAPS_KEY_ANDROID=

# SHA-1 of the certificate that signs your Android build, e.g. F0:5A:84:...:B9
# (colons optional), sent as X-Android-Cert on the REST calls. Google validates
# it against the fingerprints registered on the key — it cannot check the app's
# real signature — so ONE registered value works for every build type. Getting it
# wrong fails silently: Places returns "Requests from this Android client
# application are blocked", the app catches it, and autocomplete just stops
# suggesting.
#
#   keytool -list -v -keystore <keystore> -alias <alias>
PUBLIC_GOOGLE_MAPS_ANDROID_CERT_SHA1=
