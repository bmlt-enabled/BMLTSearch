{
  "name": "bmlt-search",
  "private": true,
  "version": "6.0.0",
  "license": "MIT",
  "type": "module",
  "author": "BMLT Enabled",
  "homepage": "https://app.bmlt.app/",
  "description": "Cross-platform NA meeting search built on the BMLT, in SvelteKit + Capacitor.",
  "scripts": {
    "#Core": "Web development and build",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "#Device dev": "Serve the bundle to a real device for HMR — see capacitor.config.ts",
    "dev:host": "vite dev --host --port 5001",
    "#Native sync": "Copy the built web bundle into the native projects",
    "sync": "cap sync",
    "sync:ios": "cap sync ios",
    "sync:android": "cap sync android",
    "#Icons": "Regenerate every launcher icon and splash from assets/ — see assets/README.md",
    "assets": "node scripts/generate-assets.mjs",
    "#Native open": "Build, sync, then open the platform IDE",
    "ios": "run-s build sync:ios open:ios",
    "android": "run-s build sync:android open:android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "#Release": "Build, sign and upload exactly as CI does — reads .env.release (op:// refs) via `op run`; see .env.release.example",
    "release:ios": "bash scripts/release-ios.sh",
    "release:android": "bash scripts/release-android.sh",
    "#Quality": "Checks",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "all": "npm run format && npm run lint && npm run check && npm run test && npm run build"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/google.maps": "^3.65.5",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/google-maps": "^8.0.1",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@lucide/svelte": "^1.32.0"
  }
}
