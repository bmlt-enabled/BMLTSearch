# 1Password-backed release secrets. Resolved by `op run --env-file=.env.release`
# (see scripts/release-*.sh) and can feed `gh secret set` from the same source.
# Gitignored — the committed template is .env.release.example.

APPLE_TEAM_ID="op://Private/BMLT Search iOS/team id"
APPSTORE_KEY_ID="op://Private/BMLT Search iOS/key id"
APPSTORE_ISSUER_ID="op://Private/BMLT Search iOS/issuer id"
APPSTORE_PRIVATE_KEY="op://Private/BMLT Search iOS/AuthKey/p8"
IOS_DIST_CERT_P12_BASE64="op://Private/BMLT Search iOS/p12 base64"
IOS_DIST_CERT_PASSWORD="op://Private/BMLT Search iOS/p12 password"

ANDROID_KEYSTORE_BASE64="op://Private/BMLT Search Android/keystore base64"
ANDROID_KEYSTORE_PASSWORD="op://Private/BMLT Search Android/keystore password"
ANDROID_KEY_ALIAS="op://Private/BMLT Search Android/key alias"
ANDROID_KEY_PASSWORD="op://Private/BMLT Search Android/key password"
PLAY_SERVICE_ACCOUNT_JSON="op://Private/BMLT Search Android/service account json"
